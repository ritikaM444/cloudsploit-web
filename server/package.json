{
  "name": "cloudsploit-web-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web API and scan worker that wraps CloudSploit. Security-first, zero-cost.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "genkey": "node scripts/generate-key.mjs",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": {
  "@fastify/cookie": "^11.1.3",
  "@fastify/cors": "^11.3.1",
  "@fastify/helmet": "^13.1.2",
  "@fastify/jwt": "^10.2.4",
  "@fastify/rate-limit": "^11.2.1",
  "@fastify/static": "^10.1.6",
  "cloudsploit-web": "file:..",
  "fastify": "^5.12.5",
  "tsx": "^4.23.15",
  "zod": "^4.6.6"
},
"devDependencies": {
  "@types/node": "^26.6.5",
  "typescript": "^7.0.2"
}
}

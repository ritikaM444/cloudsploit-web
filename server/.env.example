# ---- Server ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Where the SQLite DB and scan artifacts live (relative to server/ or absolute)
DATA_DIR=./data

# ---- Secrets (REQUIRED) ----
# Run `npm run genkey` to generate these two values, then paste them here.
# JWT_SECRET: any long random string (>= 32 chars)
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# MASTER_KEY: base64-encoded 32-byte key used to encrypt cloud credentials at rest
MASTER_KEY=replace-me-with-base64-32-bytes

# ---- Frontend / CORS ----
# Dev frontend origin (Vite). In production the API serves the built client, same origin.
CORS_ORIGIN=http://localhost:5173
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ---- Scanner ----
# Path to the CloudSploit CLI entrypoint (relative to server/ or absolute)
SCANNER_PATH=../cloudsploit/index.js
SCANNER_TIMEOUT_MS=600000
WORKER_INTERVAL_MS=3000
WORKER_CONCURRENCY=1
